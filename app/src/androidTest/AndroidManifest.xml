<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="app.cleanroom.streamlab" />
    </queries>
    <application>
        <receiver android:name="app.cleanroom.streamlab.ExternalBrowserProbe"
            android:exported="true">
            <intent-filter>
                <action android:name="app.cleanroom.streamlab.test.PROBE_BROWSER" />
            </intent-filter>
        </receiver>
        <receiver android:name="app.cleanroom.streamlab.ExternalResumeProbe"
            android:exported="true">
            <intent-filter>
                <action android:name="app.cleanroom.streamlab.test.PROBE_RESUME" />
            </intent-filter>
        </receiver>
        <receiver android:name="app.cleanroom.streamlab.ExternalColdSelectionProbe"
            android:exported="true">
            <intent-filter>
                <action android:name="app.cleanroom.streamlab.test.PROBE_COLD_SELECTION" />
            </intent-filter>
        </receiver>
        <receiver android:name="app.cleanroom.streamlab.ExternalStaleResumeProbe"
            android:exported="true">
            <intent-filter>
                <action android:name="app.cleanroom.streamlab.test.PROBE_STALE_RESUME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
