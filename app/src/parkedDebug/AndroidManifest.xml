<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="StreamLab Passagers"
        android:appCategory="game"
        tools:replace="android:label">

        <!-- Complete app on its own: the whole phone app and its player are kept. A single phone
             icon: the car launcher entry below opens this screen when tapped on the phone. -->
        <activity android:name=".MainActivity" android:exported="false" tools:node="merge" tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name=".PassengerRadioActivity"
            android:taskAffinity="app.cleanroom.streamlab.car.screen"
            android:exported="false"
            android:label="Radio - StreamLab Passagers"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density"
            android:resizeableActivity="true" />

        <activity
            android:name=".PassengerPlayerActivity"
            android:taskAffinity="app.cleanroom.streamlab.car.screen"
            android:exported="false"
            android:label="TV - StreamLab Passagers"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density"
            android:resizeableActivity="true" />

        <activity
            android:name=".CarServicesActivity"
            android:taskAffinity="app.cleanroom.streamlab.car.screen"
            android:exported="true"
            tools:replace="android:exported,android:label"
            android:label="StreamLab Passagers"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Personal build only (AGENTS.md exception). Android Auto runs parked apps only in the
                     "game" category (developer.android.com/training/cars/parked/auto) and closes them as
                     soon as the car moves; playback also pauses on onPause, which Android Auto triggers
                     when it covers the screen. The Play build never declares any of this. -->
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

