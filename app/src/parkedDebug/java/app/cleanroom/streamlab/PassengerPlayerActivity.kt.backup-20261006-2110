    private fun connect() {
        val component = ComponentName(CarServicesActivity.MAIN_APP_PACKAGE, PlaybackService::class.java.name)
        val token = SessionToken(this, component)
        val executor = ContextCompat.getMainExecutor(this)

        // The browser is catalog-only. Keeping video rendering on a dedicated MediaController
        // reproduces the path already validated by PassengerPlaybackActivity on the DHU.
        val browserFuture = MediaBrowser.Builder(this, token).buildAsync()
        browserFuture.addListener({
            runCatching { browserFuture.get() }
                .onSuccess { connectedBrowser ->
                    browser = connectedBrowser
                    loadTv(connectedBrowser)
                }
                .onFailure { status.text = "Catalogue StreamLab indisponible : ${it.javaClass.simpleName}" }
        }, executor)

        val controllerFuture = MediaController.Builder(this, token).buildAsync()
        controllerFuture.addListener({
            runCatching { controllerFuture.get() }
                .onSuccess { controller ->
                    playbackController = controller
                    controller.addListener(playbackListener)
                    playerView.player = controller
                    status.text = "ConnectÃ©"
                    syncSelectionToPlayback()
                    updateStatus()
                }
                .onFailure { status.text = "Lecteur StreamLab indisponible : ${it.javaClass.simpleName}" }
        }, executor)
    }

    private fun loadTv(connected: MediaBrowser) {
        val future = connected.getChildren(AutoLibrary.TV, 0, 100, null)
        future.addListener({
            runCatching { future.get() }
                .onSuccess { result ->
                    channels = result.value.orEmpty().distinctBy {
                        it.mediaMetadata.title?.toString()?.trim()?.lowercase().orEmpty().ifBlank { it.mediaId }
                    }
                    if (channels.isEmpty()) {
                        selectedTitle.text = "Aucune chaÃ®ne TV"
                        status.text = "Catalogue TV vide"
                        return@onSuccess
                    }
                    syncSelectionToPlayback()
                    renderSelection()
                    selectedTitle.requestFocus()
                }
                .onFailure { status.text = "Catalogue TV indisponible : ${it.javaClass.simpleName}" }
        }, ContextCompat.getMainExecutor(this))
    }

    private fun moveSelection(delta: Int) {
        if (channels.isEmpty()) return
        selectedIndex = (selectedIndex + delta + channels.size) % channels.size
        renderSelection()
    }

    private fun syncSelectionToPlayback() {
        if (channels.isEmpty()) return
        val currentId = playbackController?.currentMediaItem?.mediaId ?: return
        val index = channels.indexOfFirst { it.mediaId == currentId }
        if (index >= 0) selectedIndex = index
    }

    private fun renderSelection() {
        val item = channels.getOrNull(selectedIndex) ?: return
        selectedTitle.text = item.mediaMetadata.title?.toString().orEmpty().ifBlank { "ChaÃ®ne TV" }
        selectedTitle.contentDescription = "Regarder ${selectedTitle.text}"
        status.text = "${selectedIndex + 1} / ${channels.size}"
    }

    private fun playSelected() {
        val item = channels.getOrNull(selectedIndex) ?: return
        val active = playbackController ?: return
        val title = item.mediaMetadata.title?.toString().orEmpty().ifBlank { "TV" }
        if (active.currentMediaItem?.mediaId == item.mediaId && active.playbackState != Player.STATE_IDLE) {
            // Do not tear down a healthy video decoder just to reveal the same channel.
            if (!active.isPlaying) active.play()
            showFullScreen(title)
            return
        }
        active.setMediaItem(MediaItem.Builder().setMediaId(item.mediaId).build())
        active.prepare()
        active.play()
        showFullScreen(title)
    }

    private fun showFullScreen(title: String) {
        fullScreen = true
        selector.visibility = View.GONE
        channelsButton.visibility = View.VISIBLE
        channelsButton.requestFocus()
        nowPlaying.text = "$title  Â·  â†/â†’ pour zapper"
        nowPlaying.visibility = View.VISIBLE
        nowPlaying.removeCallbacks(hideOverlay)
        nowPlaying.postDelayed(hideOverlay, 3000)
        playerView.showController()
    }

    private val hideOverlay = Runnable { if (fullScreen) nowPlaying.visibility = View.GONE }

    private fun showSelector() {
        fullScreen = false
        channelsButton.visibility = View.GONE
        selector.visibility = View.VISIBLE
        renderSelection()
        selectedTitle.requestFocus()
    }

    private fun zap(delta: Int) {
        moveSelection(delta)
        playSelected()
    }

    private fun updateStatus() {
        val active = playbackController ?: return
        val title = active.currentMediaItem?.mediaMetadata?.title?.toString().orEmpty().ifBlank { "TV" }
        val state = when (active.playbackState) {
            Player.STATE_BUFFERING -> "chargementâ€¦"
            Player.STATE_READY -> if (active.isPlaying) "lecture" else "prÃªt"
            Player.STATE_ENDED -> "terminÃ©"
            else -> "attente"
        }
        if (fullScreen) {
            nowPlaying.text = "$title Â· $state"
            if (active.playbackState == Player.STATE_READY && active.isPlaying) {
                nowPlaying.removeCallbacks(hideOverlay)
                nowPlaying.postDelayed(hideOverlay, 1800)
            } else {
                nowPlaying.visibility = View.VISIBLE
            }
        } else {
            status.text = "${selectedIndex + 1} / ${channels.size} Â· $state"
        }
    }

    @SuppressLint("RestrictedApi", "GestureBackNavigation")
    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
        Log.d("StreamLabKeys", "dispatch action=${event.action} key=${event.keyCode} source=${event.source} full=$fullScreen")
        if (event.action != KeyEvent.ACTION_UP) return super.dispatchKeyEvent(event)
        return when (event.keyCode) {
            KeyEvent.KEYCODE_DPAD_LEFT -> { if (fullScreen) zap(-1) else moveSelection(-1); true }
            KeyEvent.KEYCODE_DPAD_RIGHT -> { if (fullScreen) zap(1) else moveSelection(1); true }
            KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER -> {
                if (!fullScreen) playSelected() else playerView.showController()
                true
            }
            KeyEvent.KEYCODE_BACK -> {
                if (fullScreen) showSelector() else finish()
                true
            }
            else -> super.dispatchKeyEvent(event)
        }
    }

    override fun onDestroy() {
        nowPlaying.removeCallbacks(hideOverlay)
        playerView.player = null
        playbackController?.removeListener(playbackListener)
        playbackController?.release()
        playbackController = null
        browser?.release()
        browser = null
        super.onDestroy()
    }
}

