*.log
# Keep third-party binaries local pending rights/provenance review
/app/libs/*.aar
# Non-public playlists and local QA fixtures
/qa-fixtures/
# Device screenshots/UI dumps: retained in local backup, not source history
/tools/dhu/*.png
/tools/dhu/*.xml
# Local diagnostic excerpts retained by AppFactory full snapshot
/ecc-*.txt
/ecc-services-last.txt
/ECC_ANDROID_AUTO_LAST*.txt

# AppFactory: detached, isolated experiment branches
/.worktrees/
*.backup-*
